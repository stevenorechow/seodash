		"name": "Steven Orechow",
		"url": "https://stevenorechow.me"
	},
	"security": {
		"email": "stevenorechow@pm.me"
	},
	"repo": "https://github.com/stevenorechow/seodash",
	"sections": {
		"description": {
			"file": "listing/description.md"
		},
		"installation": {
			"file": "listing/installation.md"
		},
		"faq": {
			"file": "listing/faq.md"
		},
		"changelog": {
			"file": "listing/changelog.md"
		}
	},
	"release": {
		"artifacts": {
			"icon": {
				"file": "icon.png"
			},
			"screenshots": [
				{
					"file": "listing/screenshots/1-editor-panel.png"
				},
				{
					"file": "listing/screenshots/2-content-analysis.png"
				},
				{
					"file": "listing/screenshots/3-overview.png"
				},
				{
					"file": "listing/screenshots/4-content.png"
				},
				{
					"file": "listing/screenshots/5-titles.png"
				},
				{
					"file": "listing/screenshots/6-dashboard.png"
				},
				{
					"file": "listing/screenshots/7-features.png"
				}
			]
		}
	},
	"capabilities": [
		"content:read",
		"hooks.content-policy:register",
		"network:request",
		"schema:read",
		"taxonomies:read"
	],
	"allowedHosts": [
		"api.indexnow.org",
		"indexing.googleapis.com",
		"oauth2.googleapis.com"
	],
	"storage": {
		"entries": {
			"indexes": [
				"collection",
				"updatedAt"
			]
		},
		"schemas": {
			"indexes": [
				"collection",
				"entryKey"
			]
		},
		"audit": {
			"indexes": [
				"collection",
				"score",
				"scannedAt"
			]
		},
		"indexing": {
			"indexes": [
				"at",
				"entryKey",
				[
					"entryKey",
					"at"
				]
			]
		}
	},
	"admin": {
		"settingsSchema": {
			"secret:google-service-account": {
				"type": "secret",
				"label": "Google service account key"
			}
		},
		"pages": [
			{
				"path": "/overview",
				"label": "Overview",
				"icon": "dashboard",
				"group": "SEO"
			},
			{
				"path": "/content",
				"label": "Content",
				"icon": "list",
				"group": "SEO"
			},
			{
				"path": "/titles",
				"label": "Titles & meta",
				"icon": "tag",
				"group": "SEO"
			},
			{
				"path": "/social",
				"label": "Social",
				"icon": "users",
				"group": "SEO"
			},
			{
				"path": "/schema",
				"label": "Structured data",
				"icon": "code",
				"group": "SEO"
			},
			{
				"path": "/settings",
				"label": "Settings",
				"icon": "settings",
				"group": "SEO"
			}
		],
		"widgets": [
			{
				"id": "health",
				"title": "SEO health",
				"size": "half"
			}
		],
		"editorPanels": [
			{
				"id": "seo",
				"title": "SEOdash",
				"route": "entry"
			}
		]
	}
